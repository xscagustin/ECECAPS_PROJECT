
#create tables
CREATE DATABASE HospitalDatabase;
USE HospitalDatabase;
CREATE TABLE Inventory(
    item_name VARCHAR(50),
    sku_id VARCHAR(12),
    quantity INT,
    date DATE,
    time TIME,
    package_id VARCHAR(6)
);

CREATE TABLE Requests(
    item_name VARCHAR(50),
    quantity INT,
    date DATE,
    time TIME,
    courier_id VARCHAR(4),
    requester_id VARCHAR(4),
    state VARCHAR(10)
);


